ENVIRONMENT=local
DEBUG=true

# Local PostgreSQL 18 + pgvector (Homebrew) on port 5433
DATABASE_URL=postgresql+asyncpg://evaluation:evaluation@localhost:5433/evaluation
# Create missing tables on startup. Set to false in UAT/production (use Alembic there).
AUTO_CREATE_TABLES=true

# Local Redis (Homebrew) for the background worker
REDIS_URL=redis://localhost:6379/0

CORS_ORIGINS=["http://localhost:5173"]

# Source-document storage (AWS S3). Not used until Phase 2 ingestion.
S3_BUCKET=evaluation-source-documents
S3_ENDPOINT_URL=
AWS_REGION=ap-south-1

# LLM + embeddings. Leave blank until the provider and data-handling policy are approved.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=high
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-3.5
EMBEDDING_DIMENSIONS=1024
